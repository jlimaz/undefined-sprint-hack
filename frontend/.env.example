# Local Ollama. Must match a model from `ollama list`, and the model the
# pipeline loads (OLLAMA_MODEL in its own environment): a small GPU holds one.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:14b
# Optional larger context window for the chat. Unset uses Ollama's default.
# OLLAMA_NUM_CTX=8192

# Laya pipeline service (pipeline/server.py), used by the Library and the agent.
PIPELINE_API_URL=http://127.0.0.1:8000

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=assistant-ui-with-langgraph-template

# Frontend (Next.js proxy to LangGraph)
LANGGRAPH_API_URL=http://localhost:2024
# Forwarded as `x-api-key`. Leave blank for local dev.
LANGCHAIN_API_KEY=
# Graph id. Must match a key under "graphs" in langgraph.json.
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=agent
# Browser talks to the local LangGraph server directly so chat tokens stream.
NEXT_PUBLIC_LANGGRAPH_API_URL=http://localhost:2024
