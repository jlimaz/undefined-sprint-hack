{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n frontend,backend,pipeline -c cyan,magenta,yellow npm:dev:frontend npm:dev:backend npm:dev:pipeline",
    "dev:frontend": "next dev --turbopack",
    "dev:backend": "langgraphjs dev --no-browser",
    "dev:pipeline": "cd .. && .venv/bin/python -m uvicorn pipeline.server:app --host 127.0.0.1 --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint:fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.23",
    "@assistant-ui/react-langchain": "latest",
    "@assistant-ui/react-markdown": "^0.14.18",
    "@base-ui/react": "^1.8.0",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-sdk": "^1.11.0",
    "@langchain/ollama": "^1.3.0",
    "@langchain/react": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@assistant-ui/next": "latest",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph-cli": "^1.4.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
